// =============================================================================
// Wallet Gateway — user-management service database  (PostgreSQL 16)
//
// Reverse-engineered from migrations/0001..0009. Nothing here is invented:
// every table, column, type, key, constraint and index below appears in the
// migration files. Relationships that the database does NOT enforce are kept
// out of the Ref list and collected, commented out, at the bottom.
//
// Paste into https://dbdiagram.io/d
// =============================================================================

Project wallet_gateway {
  database_type: 'PostgreSQL'
  Note: '''
    Single service database (user-management). 15 tables.
    Row-Level Security is enabled on 12 of them; the app connects as the
    non-owner role `wallet_app` so RLS is actually enforced.
    Requires extensions: citext, pgcrypto.
  '''
}

// ─── Tenancy ────────────────────────────────────────────────────────────────

Table tenants {
  id uuid [pk, default: `gen_random_uuid()`]
  name text [not null]
  slug citext [not null, note: 'unique per live row']
  status text [not null, default: 'pending', note: 'pending | active | suspended | terminated']
  settings jsonb [not null, default: `'{}'`]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  created_by uuid [note: 'no FK — see inferred relationships']
  updated_by uuid [note: 'no FK — see inferred relationships']
  version bigint [not null, default: 1, note: 'optimistic locking']
  deleted_at timestamptz [note: 'soft delete']

  Indexes {
    slug [unique, name: 'ux_tenants_slug', note: 'partial: WHERE deleted_at IS NULL']
    status [name: 'ix_tenants_status', note: 'partial: WHERE deleted_at IS NULL']
  }
  Note: 'RLS: platform sees all; a tenant may read and update only its own row.'
}

Table organization_units {
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [not null]
  parent_id uuid [note: 'self-reference: org tree']
  name text [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  created_by uuid
  updated_by uuid
  version bigint [not null, default: 1]

  Indexes {
    (tenant_id, parent_id, name) [unique, name: 'organization_units_tenant_id_parent_id_name_key']
    tenant_id [name: 'ix_org_units_tenant']
  }
  Note: 'Backs the team / organization / descendants permission scopes. No CRUD endpoint exists yet.'
}

// ─── Identity ───────────────────────────────────────────────────────────────

Table users {
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [note: 'NULL = platform user (enforced by chk_platform_user_tenant)']
  organization_unit_id uuid
  user_type text [not null, default: 'tenant_user', note: 'platform_user | tenant_user | service_account']
  email citext [not null]
  first_name text [not null, default: '']
  last_name text [not null, default: '']
  phone text
  status text [not null, default: 'pending', note: 'pending | active | suspended | locked | disabled']
  must_change_password boolean [not null, default: false]
  internal_notes text [note: 'protected field — needs users.read.internal_notes']
  security_flags jsonb [not null, default: `'{}'`, note: 'platform-only read']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  created_by uuid
  updated_by uuid
  version bigint [not null, default: 1]
  deleted_at timestamptz

  Indexes {
    (tenant_id, email) [unique, name: 'ux_users_tenant_email', note: 'actually COALESCE(tenant_id, zero-uuid), email WHERE deleted_at IS NULL — platform users share one namespace']
    (tenant_id, status) [name: 'ix_users_tenant_status', note: 'partial: WHERE deleted_at IS NULL']
    (tenant_id, created_at, id) [name: 'ix_users_tenant_created', note: 'created_at DESC, keyset pagination, partial']
  }
  Note: 'CHECK chk_platform_user_tenant: platform_user <=> tenant_id IS NULL.'
}

Table user_credentials {
  user_id uuid [pk, note: 'PK is also the FK — strict 1:1 with users']
  tenant_id uuid [note: 'denormalized for RLS, no FK']
  password_hash text [not null, note: 'Argon2id PHC string']
  password_changed_at timestamptz [not null, default: `now()`]
  failed_login_attempts int [not null, default: 0]
  locked_until timestamptz
  last_login_at timestamptz
  updated_at timestamptz [not null, default: `now()`]

  Note: 'Secrets live here, not on users, so a user DTO can never carry them.'
}

Table sessions {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null]
  tenant_id uuid [note: 'denormalized for RLS, no FK']
  family_id uuid [not null, note: 'refresh-token family; reuse revokes the whole family']
  refresh_token_hash text [not null, note: 'SHA-256; plaintext never stored']
  status text [not null, default: 'active', note: 'active | rotated | revoked | reused']
  ip text
  user_agent text
  created_at timestamptz [not null, default: `now()`]
  last_used_at timestamptz [not null, default: `now()`]
  expires_at timestamptz [not null]
  revoked_at timestamptz
  revoke_reason text

  Indexes {
    refresh_token_hash [unique, name: 'ux_sessions_refresh_hash']
    (user_id, status) [name: 'ix_sessions_user']
    family_id [name: 'ix_sessions_family']
    expires_at [name: 'ix_sessions_expiry', note: 'partial: WHERE status = active']
  }
}

// ─── Authorization ──────────────────────────────────────────────────────────

Table permission_definitions {
  id uuid [pk, default: `gen_random_uuid()`]
  service text [not null]
  resource text [not null]
  action text [not null, note: 'create|read|update|delete|search|list|assign|revoke|export|rotate']
  field text [note: 'NULL = action-level; non-NULL = field-level grant']
  description text [not null, default: '']
  is_platform_only boolean [not null, default: false]
  created_at timestamptz [not null, default: `now()`]

  Indexes {
    (service, resource, action, field) [unique, name: 'ux_permission_defs', note: 'actually COALESCE(field, "") so one NULL-field row per action']
  }
  Note: 'Global read-only catalogue. No RLS; wallet_app has SELECT only (INSERT/UPDATE/DELETE revoked). 63 rows seeded by 0008 + 0009.'
}

Table roles {
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [note: 'NULL = system role, readable by every tenant']
  name text [not null]
  description text [not null, default: '']
  role_type text [not null, note: 'platform | tenant']
  is_system boolean [not null, default: false]
  status text [not null, default: 'active', note: 'active | disabled']
  parent_role_id uuid [note: 'self-reference; declared but not used by the engine']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  created_by uuid
  updated_by uuid
  version bigint [not null, default: 1]
  deleted_at timestamptz

  Indexes {
    (tenant_id, name) [unique, name: 'ux_roles_tenant_name', note: 'actually COALESCE(tenant_id, zero-uuid), lower(name) WHERE deleted_at IS NULL']
    tenant_id [name: 'ix_roles_tenant', note: 'partial: WHERE deleted_at IS NULL']
  }
  Note: 'CHECK chk_system_roles_global: a system role must be global (tenant_id IS NULL).'
}

Table role_permissions {
  id uuid [pk, default: `gen_random_uuid()`]
  role_id uuid [not null]
  tenant_id uuid [note: 'denormalized for RLS, no FK']
  permission_id uuid [not null]
  scope text [not null, default: 'tenant', note: 'own|assigned|team|organization|tenant|descendants|all']
  effect text [not null, default: 'allow', note: 'allow | deny — deny wins']
  conditions jsonb [not null, default: `'{}'`]
  created_by uuid
  created_at timestamptz [not null, default: `now()`]

  Indexes {
    (role_id, permission_id, scope, effect) [unique, name: 'role_permissions_role_id_permission_id_scope_effect_key']
    role_id [name: 'ix_role_permissions_role']
  }
  Note: 'Association table WITH attributes: the same (role, permission) pair may repeat at different scope/effect.'
}

Table user_roles {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null]
  role_id uuid [not null]
  tenant_id uuid [note: 'denormalized for RLS, no FK']
  assigned_by uuid
  created_at timestamptz [not null, default: `now()`]

  Indexes {
    (user_id, role_id) [unique, name: 'user_roles_user_id_role_id_key']
    user_id [name: 'ix_user_roles_user']
    role_id [name: 'ix_user_roles_role']
  }
  Note: 'Pure junction: one row per (user, role).'
}

Table user_permissions {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null]
  tenant_id uuid [note: 'denormalized for RLS, no FK']
  permission_id uuid [not null]
  scope text [not null, default: 'own']
  effect text [not null, default: 'allow']
  conditions jsonb [not null, default: `'{}'`]
  granted_by uuid
  created_at timestamptz [not null, default: `now()`]
  expires_at timestamptz [note: 'optional time-boxed grant']

  Indexes {
    (user_id, permission_id, scope, effect) [unique, name: 'user_permissions_user_id_permission_id_scope_effect_key']
    user_id [name: 'ix_user_permissions_user']
  }
  Note: 'Direct grant, bypassing roles. Association table with attributes.'
}

// ─── Machine access ─────────────────────────────────────────────────────────

Table api_clients {
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [not null]
  name text [not null]
  description text [not null, default: '']
  client_id text [not null, note: 'public identifier, globally unique']
  secret_hash text [not null, note: 'Argon2id; plaintext shown once and never stored']
  allowed_ips "text[]" [not null, default: `'{}'`]
  scopes "text[]" [not null, default: `'{}'`]
  status text [not null, default: 'active', note: 'active | suspended | expired | revoked']
  expires_at timestamptz
  last_used_at timestamptz
  secret_rotated_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  created_by uuid
  updated_by uuid
  version bigint [not null, default: 1]
  deleted_at timestamptz

  Indexes {
    client_id [unique, name: 'ux_api_clients_client_id']
    (tenant_id, status) [name: 'ix_api_clients_tenant', note: 'partial: WHERE deleted_at IS NULL']
  }
}

Table api_client_permissions {
  id uuid [pk, default: `gen_random_uuid()`]
  api_client_id uuid [not null]
  tenant_id uuid [not null, note: 'NOT NULL but still no FK']
  permission_id uuid [not null]
  scope text [not null, default: 'tenant']
  effect text [not null, default: 'allow']
  conditions jsonb [not null, default: `'{}'`]
  granted_by uuid
  created_at timestamptz [not null, default: `now()`]

  Indexes {
    (api_client_id, permission_id, scope, effect) [unique, name: 'api_client_permissions_api_client_id_permission_id_scope_effect_key']
    api_client_id [name: 'ix_api_client_permissions_client']
  }
}

// ─── Platform / operations ──────────────────────────────────────────────────

Table audit_logs {
  id uuid [pk, default: `gen_random_uuid()`]
  occurred_at timestamptz [not null, default: `now()`, note: 'this table has no created_at/updated_at by design']
  actor_id uuid [note: 'polymorphic — see inferred relationships']
  actor_type text [not null, default: 'system', note: 'platform_user|tenant_user|api_client|service_account|system']
  tenant_id uuid [note: 'denormalized for RLS, no FK']
  action text [not null]
  resource text [not null]
  resource_id text [note: 'polymorphic, TEXT not UUID']
  before_state jsonb
  after_state jsonb
  changed_fields "text[]" [not null, default: `'{}'`]
  ip text
  user_agent text
  request_id text
  correlation_id text
  result text [not null, default: 'success', note: 'success | failure | denied']
  denial_reason text

  Indexes {
    (tenant_id, occurred_at, id) [name: 'ix_audit_logs_tenant_time', note: 'occurred_at DESC']
    (actor_id, occurred_at) [name: 'ix_audit_logs_actor', note: 'occurred_at DESC']
    (resource, resource_id) [name: 'ix_audit_logs_resource']
  }
  Note: 'Append-only: trigger trg_audit_logs_immutable raises on UPDATE/DELETE, and UPDATE/DELETE are revoked from wallet_app.'
}

Table outbox_events {
  id bigint [pk, increment, note: 'GENERATED ALWAYS AS IDENTITY — the only non-UUID surrogate key']
  event_id uuid [not null, unique, note: 'stable across retries; consumers dedupe on this']
  event_type text [not null, note: 'e.g. user.created.v1']
  event_version int [not null, default: 1]
  aggregate_type text [not null]
  aggregate_id text [not null, note: 'polymorphic, TEXT not UUID']
  tenant_id uuid [note: 'denormalized for RLS, no FK']
  payload jsonb [not null]
  headers jsonb [not null, default: `'{}'`]
  status text [not null, default: 'pending', note: 'pending | published | failed | dead']
  attempts int [not null, default: 0]
  next_attempt_at timestamptz [not null, default: `now()`]
  last_error text
  created_at timestamptz [not null, default: `now()`]
  published_at timestamptz

  Indexes {
    (next_attempt_at, id) [name: 'ix_outbox_pending', note: 'partial: WHERE status IN (pending, failed) — drives FOR UPDATE SKIP LOCKED']
  }
  Note: 'Transactional outbox. Written in the same transaction as the state change; drained by the worker.'
}

Table schema_migrations {
  version bigint [pk]
  name text [not null]
  applied_at timestamptz [not null, default: `now()`]

  Note: 'Created by cmd/migrate, not by a migration file. Guarded by a PostgreSQL advisory lock.'
}

// =============================================================================
// ENFORCED relationships — every one of these is a REFERENCES clause in the DDL
// =============================================================================

Ref: organization_units.tenant_id > tenants.id              [delete: cascade]
Ref: organization_units.parent_id > organization_units.id   [delete: cascade]
Ref: users.tenant_id > tenants.id                           [delete: restrict]
Ref: users.organization_unit_id > organization_units.id     [delete: set null]
Ref: user_credentials.user_id - users.id                    [delete: cascade]
Ref: sessions.user_id > users.id                            [delete: cascade]
Ref: roles.tenant_id > tenants.id                           [delete: cascade]
Ref: roles.parent_role_id > roles.id                        [delete: set null]
Ref: role_permissions.role_id > roles.id                    [delete: cascade]
Ref: role_permissions.permission_id > permission_definitions.id [delete: cascade]
Ref: user_roles.user_id > users.id                          [delete: cascade]
Ref: user_roles.role_id > roles.id                          [delete: cascade]
Ref: user_permissions.user_id > users.id                    [delete: cascade]
Ref: user_permissions.permission_id > permission_definitions.id [delete: cascade]
Ref: api_clients.tenant_id > tenants.id                     [delete: cascade]
Ref: api_client_permissions.api_client_id > api_clients.id  [delete: cascade]
Ref: api_client_permissions.permission_id > permission_definitions.id [delete: cascade]

// =============================================================================
// INFERRED relationships — NOT enforced by the database.
//
// Left commented out deliberately: drawing them would claim constraints the
// schema does not have. Uncomment only if you want them on the canvas, and
// read docs/database/README.md for why each one is unenforced.
// =============================================================================

// -- tenant_id denormalized onto child tables so RLS can filter without a join.
//    A stale or wrong value is possible; nothing rejects it.
// Ref: user_credentials.tenant_id > tenants.id
// Ref: sessions.tenant_id > tenants.id
// Ref: role_permissions.tenant_id > tenants.id
// Ref: user_roles.tenant_id > tenants.id
// Ref: user_permissions.tenant_id > tenants.id
// Ref: api_client_permissions.tenant_id > tenants.id
// Ref: audit_logs.tenant_id > tenants.id
// Ref: outbox_events.tenant_id > tenants.id

// -- Actor columns. Left unconstrained so an audit trail survives user deletion.
// Ref: tenants.created_by > users.id
// Ref: tenants.updated_by > users.id
// Ref: organization_units.created_by > users.id
// Ref: organization_units.updated_by > users.id
// Ref: users.created_by > users.id
// Ref: users.updated_by > users.id
// Ref: roles.created_by > users.id
// Ref: roles.updated_by > users.id
// Ref: role_permissions.created_by > users.id
// Ref: user_roles.assigned_by > users.id
// Ref: user_permissions.granted_by > users.id
// Ref: api_clients.created_by > users.id
// Ref: api_clients.updated_by > users.id
// Ref: api_client_permissions.granted_by > users.id

// -- Polymorphic. No single target table, so no FK is possible.
//    audit_logs.actor_id     -> users.id OR api_clients.id, discriminated by actor_type
//    audit_logs.resource_id  -> any table, TEXT, discriminated by resource
//    outbox_events.aggregate_id -> any table, TEXT, discriminated by aggregate_type
