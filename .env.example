# ─── Wallet Gateway — Environment Variables ────────────────────────────────
# Copy to .env for local development. NEVER commit a real .env file.

# ── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=wallet_gateway
# Owner/migration role (bypasses RLS as table owner — migrations & seed only)
POSTGRES_USER=wallet
POSTGRES_PASSWORD=wallet_dev_password
# Application role (Row-Level Security IS enforced for this role)
POSTGRES_APP_USER=wallet_app
POSTGRES_APP_PASSWORD=wallet_app_dev_password

DATABASE_URL=postgres://wallet:wallet_dev_password@localhost:5432/wallet_gateway?sslmode=disable
DATABASE_APP_URL=postgres://wallet_app:wallet_app_dev_password@localhost:5432/wallet_gateway?sslmode=disable

# ── Redis ───────────────────────────────────────────────────────────────────
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# ── Kafka ───────────────────────────────────────────────────────────────────
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC_PREFIX=wallet-gateway
KAFKA_DLQ_TOPIC=wallet-gateway.dlq

# ── OPA / OpenFGA ───────────────────────────────────────────────────────────
OPA_URL=http://localhost:8181

OPA_STUDIO_PORT=3020
OPA_STUDIO_USER=admin
OPA_STUDIO_PASSWORD=your-strong-password
OPENFGA_URL=http://localhost:8080
# Optional. Left empty, the service finds (or creates) the store named
# "wallet-gateway" and applies its embedded model at start-up. Pin both in
# production so deployments are deterministic.
OPENFGA_STORE_ID=
OPENFGA_MODEL_ID=
OPENFGA_STUDIO_PORT=3030

# ── JWT / Auth ──────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 64
JWT_SIGNING_KEY=dev-only-signing-key-change-me-in-production-0123456789abcdef
JWT_ISSUER=wallet-gateway
JWT_AUDIENCE=wallet-gateway-api
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
CLIENT_TOKEN_TTL=30m

# ── Bootstrap admin (LOCAL/DEV ONLY — use a secret manager in production) ──
BOOTSTRAP_ADMIN_EMAIL=sr.alasgarov@gmail.com
BOOTSTRAP_ADMIN_PASSWORD=Anh0@111118

# ── HTTP server ─────────────────────────────────────────────────────────────
HTTP_ADDR=:8090
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
REQUEST_TIMEOUT=30s
MAX_BODY_BYTES=1048576
# Requests per second per source IP. Locally everything (portal, test suites,
# curl) arrives from one docker gateway address and shares this bucket, so the
# dev value is generous. Production sees distinct client IPs — the service
# default of 50 is the sane starting point there.
RATE_LIMIT_RPS=300
# Brute-force protection: sign-ins per minute per IP. Keep this strict.
LOGIN_RATE_LIMIT_PER_MIN=10

# ── Observability ───────────────────────────────────────────────────────────
LOG_LEVEL=debug
LOG_FORMAT=json
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=user-management-service
METRICS_ADDR=:9091

# ── Outbox worker ───────────────────────────────────────────────────────────
OUTBOX_POLL_INTERVAL=1s
OUTBOX_BATCH_SIZE=100
OUTBOX_MAX_ATTEMPTS=10

# ── Admin portal ────────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8090
